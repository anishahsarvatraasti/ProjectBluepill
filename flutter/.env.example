SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# OAuth web client ID for Google Calendar and Google Tasks API access.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Do not put AI, Supabase service role, QStash, worker, or FCM secrets here.
# Flutter bundles this file as an app asset. Use server.env.example for secrets.
