SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# OAuth web client ID for Google Calendar and Google Tasks API access.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# OAuth redirect origin for production Supabase login.
# Use your Firebase Hosting or custom domain, for example:
# AUTH_REDIRECT_ORIGIN=https://your-app.web.app
AUTH_REDIRECT_ORIGIN=

# Public FastAPI worker URL for Agent chat. This is not a secret.
FASTAPI_BASE_URL=http://localhost:8000

# AI Provider: "openai", "openrouter", or "gemini" (default: openai)
AI_PROVIDER=gemini

# Gemini API (if AI_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API (if AI_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# OpenRouter API (if AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini

# Do not put AI, Supabase service role, QStash, worker, or FCM secrets here.
# Flutter bundles this file as an app asset. Use server.env.example for secrets.
