# Server-only environment values for Supabase Edge Functions and workers.
# Do not copy these into Flutter's `.env`; Flutter bundles that file as an app asset.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

QSTASH_URL=https://qstash-us-east-1.upstash.io
QSTASH_TOKEN=your-upstash-qstash-token
AGENT_DAILY_RUN_LIMIT=50

WORKER_BASE_URL=https://your-worker.example.com
WORKER_SHARED_SECRET=your-worker-shared-secret
CORS_ALLOW_ORIGINS=http://localhost:3000,https://your-app.web.app
